{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Unchained",
  "repo": "devall96/Unchained",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your copy of Whiplash (USA) for the original Xbox: its disc image (.iso), or its folder with default.xbe. Other releases are refused.",
    "check": { "file": "default.xbe", "xdvdfs": "default.xbe" },
    "dumps": [
      { "name": "USA", "size": 7825162240, "crc32": "a8b4740e" }
    ]
  },
  "prepare": {
    "program": ["Unchained.exe", "Unchained.AppImage"],
    "args": ["--prepare", "--game", "{game}"],
    "label": "Your copy checked, and the game's code built from it on this PC",
    "timeout": 3600
  },
  "start": {
    "program": ["Unchained.exe", "Unchained.AppImage"],
    "args": ["--game", "{game}"]
  },
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [
        { "path": "{data}/settings.toml", "if": "{data}/settings.toml" },
        { "path": "{install}/settings.toml", "if": "{install}/Unchained.exe" },
        { "path": "{install}/usr/bin/settings.toml", "if": "{install}/usr/bin/settings.toml" },
        { "path": "{data}/settings.toml", "if": "{install}/usr/bin/Unchained" },
        { "path": "{install}/settings.toml", "if": "{install}/portable.txt" },
        { "path": "{local}/Unchained/settings.toml" }
      ]
    }
  ],
  "saves": [
    "{install}/hdd/E/UDATA",
    "{install}/settings.toml",
    "{local}/Unchained/hdd/E/UDATA",
    "{local}/Unchained/settings.toml",
    "{data}/hdd/E/UDATA",
    "{data}/settings.toml"
  ],
  "folders": {
    "data": [
      { "path": "{data}", "if": "{data}/settings.toml" },
      { "path": "{install}", "if": "{install}/Unchained.exe" },
      { "path": "{install}/usr/bin", "if": "{install}/usr/bin/settings.toml" },
      { "path": "{data}", "if": "{install}/usr/bin/Unchained" },
      { "path": "{install}", "if": "{install}/portable.txt" },
      { "path": "{local}/Unchained" }
    ],
    "saves": [
      { "path": "{data}/hdd", "if": "{data}/hdd" },
      { "path": "{install}/hdd", "if": "{install}/Unchained.exe" },
      { "path": "{install}/usr/bin/hdd", "if": "{install}/usr/bin/hdd" },
      { "path": "{data}/hdd", "if": "{install}/usr/bin/Unchained" },
      { "path": "{install}/hdd", "if": "{install}/portable.txt" },
      { "path": "{local}/Unchained/hdd" }
    ],
    "logs": [
      { "path": "{data}/logs", "if": "{data}/logs" },
      { "path": "{install}/logs", "if": "{install}/Unchained.exe" },
      { "path": "{install}/usr/bin/logs", "if": "{install}/usr/bin/logs" },
      { "path": "{data}/logs", "if": "{install}/usr/bin/Unchained" },
      { "path": "{install}/logs", "if": "{install}/portable.txt" },
      { "path": "{local}/Unchained/logs" }
    ]
  },
  "exit_codes": {
    "3": "Unchained couldn't find your copy of Whiplash, or couldn't read it. Pick it again on the game's page.",
    "4": "Your copy is another release of Whiplash. Unchained runs the USA release for the original Xbox only.",
    "5": "The game's code couldn't be built on this PC. The newest log in Unchained's logs folder says why."
  },
  "looks": {
    "graphics_key": "renderer",
    "in": "main"
  },
  "groups": [
    { "id": "Picture" },
    { "id": "Display" },
    { "id": "HUD and prompts" },
    { "id": "Controls" },
    { "id": "Advanced", "advanced": true }
  ],
  "settings": [
    {
      "id": "preset", "label": "Graphics", "group": "Picture",
      "help": "OG Graphics shows the game as the Xbox drew it. Your own settings keeps the choices below; the others set them together.",
      "choices": [
        { "label": "Your own settings", "set": { "graphics_preset": "\"custom\"" } },
        { "label": "OG Graphics", "set": { "graphics_preset": "\"og\"" } },
        { "label": "Original, sharp", "set": { "graphics_preset": "\"original\"" } },
        { "label": "Low", "set": { "graphics_preset": "\"low\"" } },
        { "label": "High", "set": { "graphics_preset": "\"high\"" } },
        { "label": "Max", "set": { "graphics_preset": "\"max\"" } }
      ],
      "defaults": { "graphics_preset": "\"custom\"" }
    },
    {
      "id": "resolution", "label": "Resolution", "group": "Picture",
      "help": "Of your window's size. Lower renders smaller and FSR scales it up; above 100% sharpens by supersampling.",
      "choices": [
        { "label": "50%", "set": { "render_percent": "50" } },
        { "label": "75%", "set": { "render_percent": "75" } },
        { "label": "100%", "set": { "render_percent": "100" } },
        { "label": "150%", "set": { "render_percent": "150" } },
        { "label": "200%", "set": { "render_percent": "200" } }
      ],
      "defaults": { "render_percent": "100" },
      "when": { "graphics_preset": "\"custom\"" }
    },
    {
      "id": "upscaler", "label": "Upscaling", "group": "Picture",
      "help": "AMD FSR 1 keeps the picture sharp when it renders smaller than your window.",
      "choices": [
        { "label": "FSR 1", "set": { "upscaler": "1" } },
        { "label": "Off", "set": { "upscaler": "0" } }
      ],
      "defaults": { "upscaler": "1" },
      "when": { "graphics_preset": "\"custom\"" }
    },
    {
      "id": "filtering", "label": "Texture filtering", "group": "Picture",
      "help": "Keeps floors and walls sharp at shallow angles. Costs next to nothing.",
      "choices": [
        { "label": "16x", "set": { "anisotropic_filtering": "16" } },
        { "label": "8x", "set": { "anisotropic_filtering": "8" } },
        { "label": "4x", "set": { "anisotropic_filtering": "4" } },
        { "label": "As the game asks", "set": { "anisotropic_filtering": "0" } }
      ],
      "defaults": { "anisotropic_filtering": "16" },
      "when": { "graphics_preset": "\"custom\"" }
    },
    {
      "id": "clean_edges", "label": "Clean menu and HUD edges", "group": "Picture",
      "help": "Text, menu frames and the HUD's icons drawn with sharp edges instead of blurry pixels.",
      "choices": [
        { "label": "On", "set": { "ui_upscale": "true" } },
        { "label": "Off", "set": { "ui_upscale": "false" } }
      ],
      "defaults": { "ui_upscale": "true" }
    },
    {
      "id": "widescreen", "label": "Widescreen", "group": "Display",
      "help": "Wider view shows more at the sides on a wide screen and keeps the HUD in shape. OG Graphics and Original show 4:3.",
      "choices": [
        { "label": "Wider view", "set": { "widescreen": "\"expand\"" } },
        { "label": "4:3 with bars", "set": { "widescreen": "\"off\"" } },
        { "label": "Stretched, as the Xbox did", "set": { "widescreen": "\"console\"" } }
      ],
      "defaults": { "widescreen": "\"expand\"" }
    },
    {
      "id": "window", "label": "Window", "group": "Display",
      "choices": [
        { "label": "Borderless", "set": { "display_mode": "\"borderless\"" } },
        { "label": "Fullscreen", "set": { "display_mode": "\"fullscreen\"" } },
        { "label": "Windowed", "set": { "display_mode": "\"windowed\"" } }
      ],
      "defaults": { "display_mode": "\"borderless\"" }
    },
    {
      "id": "vsync", "label": "V-Sync", "group": "Display",
      "help": "VRR is for G-Sync and FreeSync screens. Adaptive tears a late frame instead of holding it.",
      "choices": [
        { "label": "On", "set": { "vsync_mode": "\"on\"" } },
        { "label": "VRR", "set": { "vsync_mode": "\"vrr\"" } },
        { "label": "Adaptive", "set": { "vsync_mode": "\"adaptive\"" } },
        { "label": "Fast", "set": { "vsync_mode": "\"fast\"" } },
        { "label": "Off", "set": { "vsync_mode": "\"off\"" } }
      ],
      "defaults": { "vsync_mode": "\"on\"" }
    },
    {
      "id": "fps_cap", "label": "Frame rate", "group": "Display",
      "help": "60 is the console's. Above 60 is checked in the intro and menus only so far.",
      "choices": [
        { "label": "60", "set": { "fps_cap": "60" } },
        { "label": "Your screen's refresh rate", "set": { "fps_cap": "1" } },
        { "label": "No cap", "set": { "fps_cap": "0" } }
      ],
      "defaults": { "fps_cap": "60" }
    },
    {
      "id": "fov", "label": "Field of view", "group": "Display",
      "help": "The gameplay camera's view in degrees. The game's is 60; cutscenes keep theirs.",
      "slider": { "key": "fov", "min": 40, "max": 110, "step": 5, "format": "%d" },
      "defaults": { "fov": "60" }
    },
    {
      "id": "hud_edge", "label": "HUD at the edges", "group": "HUD and prompts",
      "help": "0% keeps the HUD where the console put it, 100% moves it out to the screen's edges.",
      "slider": { "key": "hud_edge", "min": 0, "max": 100, "step": 10, "format": "%d" },
      "defaults": { "hud_edge": "100" },
      "when": { "graphics_preset": "\"custom\"" }
    },
    {
      "id": "prompts", "label": "Button prompts", "group": "HUD and prompts",
      "help": "The buttons the game shows. The controller in use follows whichever pad you pick up.",
      "choices": [
        { "label": "The controller in use", "set": { "button_prompts": "0" } },
        { "label": "Xbox", "set": { "button_prompts": "1" } },
        { "label": "PlayStation", "set": { "button_prompts": "2" } },
        { "label": "Nintendo", "set": { "button_prompts": "3" } },
        { "label": "Original Xbox", "set": { "button_prompts": "5" } }
      ],
      "defaults": { "button_prompts": "0" }
    },
    {
      "id": "overlay", "label": "Performance overlay", "group": "HUD and prompts",
      "help": "Frame rate, frame times and lows in the corner. F10 shows or hides it in game.",
      "choices": [
        { "label": "Off", "set": { "perf_overlay": "false" } },
        { "label": "On", "set": { "perf_overlay": "true" } }
      ],
      "defaults": { "perf_overlay": "false" }
    },
    {
      "id": "camera_speed", "label": "Camera speed", "group": "Controls",
      "slider": { "key": "camera_speed", "min": 25, "max": 300, "step": 5, "format": "%d" },
      "defaults": { "camera_speed": "100" }
    },
    {
      "id": "invert_x", "label": "Invert camera left-right", "group": "Controls",
      "choices": [
        { "label": "Off", "set": { "invert_camera_x": "false" } },
        { "label": "On", "set": { "invert_camera_x": "true" } }
      ],
      "defaults": { "invert_camera_x": "false" }
    },
    {
      "id": "invert_y", "label": "Invert camera up-down", "group": "Controls",
      "choices": [
        { "label": "Off", "set": { "invert_camera_y": "false" } },
        { "label": "On", "set": { "invert_camera_y": "true" } }
      ],
      "defaults": { "invert_camera_y": "false" }
    },
    {
      "id": "vibration", "label": "Vibration", "group": "Controls",
      "slider": { "key": "vibration", "min": 0, "max": 100, "step": 10, "format": "%d" },
      "defaults": { "vibration": "100" }
    },
    {
      "id": "renderer", "label": "Renderer", "group": "Advanced",
      "help": "Windows only: Vulkan, or Direct3D 12 if Vulkan gives you trouble. Linux always uses Vulkan.",
      "choices": [
        { "label": "Vulkan", "set": { "renderer": "\"vulkan\"" } },
        { "label": "Direct3D 12", "set": { "renderer": "\"d3d12\"" } }
      ],
      "defaults": { "renderer": "\"vulkan\"" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "The console's hard disk, with your save and its backups beside it.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "One log a run. Attach the newest to a bug report.", "open": "logs" },
    { "id": "shader_cache", "label": "Shader cache", "help": "Shaders and pipelines kept so later starts don't stutter. Clearing only helps if the picture looks wrong after an update.", "clear": "data/cache" }
  ]
}
